# Optional: copy to .env on the server (cp .env.example .env) to change the values. .env is never committed.
# Without .env everything works with the defaults of docker-compose.yml.

# Project name for docker-compose (keeps it apart from the other MyKyntus)
COMPOSE_PROJECT_NAME=mykyntus-suivi

# Database: by default the container mykyntus-suivi-db, created automatically.
# For an existing PostgreSQL server, set DB_HOST=10.10.10.50, DB_NAME=pilotdb, DB_USERNAME=kyntus_user...
DB_HOST=mykyntus-suivi-db
DB_PORT=5432
DB_NAME=mykyntus_suivi
DB_SCHEMA=mykyntus_suivi
DB_USERNAME=postgres
DB_PASSWORD=change-me

# Backend - JWT secret: at least 32 characters
APP_JWT_SECRET=change-me-with-a-long-random-secret-of-32-chars-min
BACKEND_PORT=8334

# Frontend - addresses seen by the browsers
FRONTEND_PORT=3955
PUBLIC_API_URL=http://10.10.10.25:8334
APP_CORS_ORIGINS=http://10.10.10.25:3955
